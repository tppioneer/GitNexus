{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitnexus.dev/benchmark/v3/report-analysis.schema.json",
  "title": "GitNexus benchmark report analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_digest",
    "executive_summary",
    "key_findings",
    "case_comparisons",
    "scoring_quality",
    "cost_quality_tradeoffs",
    "recommendations",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "executive_summary": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/nonEmptyText" } },
    "key_findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "case_comparisons": { "type": "array", "items": { "$ref": "#/$defs/comparison" } },
    "scoring_quality": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "cost_quality_tradeoffs": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } },
    "recommendations": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } }
  },
  "$defs": {
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "evidenceRef": {
      "type": "string",
      "minLength": 1,
      "description": "A run_id, score item_id, or aggregate field path from the supplied input."
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "direction", "analysis", "confidence", "evidence_refs"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "direction": { "enum": ["graph", "grep", "mixed", "neutral"] },
        "analysis": { "$ref": "#/$defs/nonEmptyText" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "graph_avg", "grep_avg", "uplift", "analysis", "evidence_refs"],
      "properties": {
        "scope": { "$ref": "#/$defs/nonEmptyText" },
        "graph_avg": { "type": "number" },
        "grep_avg": { "type": "number" },
        "uplift": { "type": "number" },
        "analysis": { "$ref": "#/$defs/nonEmptyText" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "analysis", "evidence_refs"],
      "properties": {
        "severity": { "enum": ["high", "medium", "low"] },
        "analysis": { "$ref": "#/$defs/nonEmptyText" },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    }
  }
}

